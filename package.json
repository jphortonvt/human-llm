{
  "name": "human-llm",
  "private": true,
  "version": "0.1.0",
  "description": "A gallery installation where a crowd of humans performs next-word prediction.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
